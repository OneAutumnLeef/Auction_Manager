{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/assets/(.*)", "dest": "/dist/assets/$1" },
    { "src": "/Test_Cleaned_Updated.csv", "dest": "/public/Test_Cleaned_Updated.csv" },
    { "src": "/(.*)\\.(.+)", "dest": "/dist/$1.$2" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/dist/index.html", "status": 200 }
  ]
}